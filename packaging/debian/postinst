#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    echo "======================================================"
    echo " Outlog installed successfully!"
    echo ""
    echo " To enable automatic background recording in your"
    echo " terminal sessions, run the following command as"
    echo " your normal user:"
    echo "     outlog enable"
    echo "======================================================"
fi

#DEBHELPER#
exit 0
